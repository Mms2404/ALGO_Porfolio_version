# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated origins for production CORS (leave blank in dev; allow-all is on when DEBUG=True)
CORS_ALLOWED_ORIGINS=

# --- Database (Django internals only; optional) ---
# Leave unset to use sqlite. For Postgres:
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Supabase (business datastore + auth) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Encryption keys ---
# RSA keypair for api_key/pin/totp (PEM; single-line or multi-line both accepted)
ANGEL_PUBLIC=
ANGEL_PRIVATE=
# Fernet key for jwt/feed/refresh tokens
FERNET=

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TIMEZONE=Asia/Kolkata

# --- Trade mode (DRY or LIVE) ---
# Mode (LIVE/DRY) is no longer set here -- it's per-strategy now, directly
# in algobackend/celery.py's Beat schedule kwargs (each strategy's "mode" field).